<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SWGAU</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="topbar-brand-group">
            <img src="~/img/Urbagro_logo.png" alt="Urbagro" class="topbar-logo" />
        </div>
        <nav class="topbar-nav">
            <a asp-page="/Plantas/Index">Plantas</a>
            <a href="#">Irrigación</a>
            <a href="#">Abonos</a>
        </nav>
        <form method="post" asp-page="/Logout" class="topbar-logout">
            <span>@User.Identity?.Name</span>
            <button type="submit" class="btn-link">Cerrar sesión</button>
        </form>
    </header>

    <main class="contenido">
        @RenderBody()
    </main>
</body>
</html>