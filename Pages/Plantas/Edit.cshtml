@page "{id:int}"
@model SWGAU.Pages.Plantas.EditModel
@using SWGAU.Models.Enums
@{
    ViewData["Title"] = "Editar planta";
}

<h1>Editar planta</h1>

<form method="post" class="formulario">
    <input type="hidden" asp-for="Planta.PlantaId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label asp-for="Planta.NombrePlanta"></label>
        <input asp-for="Planta.NombrePlanta" class="form-control" />
        <span asp-validation-for="Planta.NombrePlanta" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Planta.NombreCientifico"></label>
        <input asp-for="Planta.NombreCientifico" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Planta.TipoPlanta"></label>
        <select asp-for="Planta.TipoPlanta" class="form-control" asp-items="Html.GetEnumSelectList<TipoPlanta>()">
        </select>
        <span asp-validation-for="Planta.TipoPlanta" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Planta.FechaSiembra"></label>
        <input asp-for="Planta.FechaSiembra" class="form-control" />
        <span asp-validation-for="Planta.FechaSiembra" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Planta.MetodoSiembra"></label>
        <input asp-for="Planta.MetodoSiembra" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Planta.Observaciones"></label>
        <textarea asp-for="Planta.Observaciones" class="form-control" rows="3"></textarea>
    </div>

    <div class="botones">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>