@page
@model SWGAU.Pages.RegistroUsuarioModel
@using SWGAU.Models
@using SWGAU.Models.Enums
@{
    // Creacion de la vista para la página de registro de usuario

    ViewData["Title"] = "Crear cuenta";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>SWGAU - Crear cuenta</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-body">
    <div class="login-card">
        <h1>Urbagro</h1>
        <p class="subtitle">Crear una cuenta nueva</p>

        @if (!string.IsNullOrEmpty(Model.MensajeError))
        {
            <div class="alert alert-error">@Model.MensajeError</div>
        }
        <form method="post">
            <div class="form-group">
                <label asp-for="Input.NombreUsuario"></label>
                <input asp-for="Input.NombreUsuario" class="form-control" autofocus />
                <span asp-validation-for="Input.NombreUsuario" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.CorreoElectronico"></label>
                <input asp-for="Input.CorreoElectronico" class="form-control" type="email" />
                <span asp-validation-for="Input.CorreoElectronico" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Rol"></label>
                <select asp-for="Input.Rol" class="form-control"
                        asp-items="Html.GetEnumSelectList<RolUsuario>()">
                </select>
                <span asp-validation-for="Input.Rol" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Contrasena"></label>
                <input asp-for="Input.Contrasena" class="form-control" />
                <span asp-validation-for="Input.Contrasena" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.ConfirmarContrasena"></label>
                <input asp-for="Input.ConfirmarContrasena" class="form-control" />
                <span asp-validation-for="Input.ConfirmarContrasena" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary">Crear cuenta</button>
        </form>

        <p class="subtitle" style="margin-top: 20px;">
            <a asp-page="Login">¿Ya tienes una cuenta? Inicia sesión aquí.</a>
        </p>
    </div>
</body>
</html>